{
  "name": "watchticker",
  "productName": "WatchTicker",
  "version": "0.1.0",
  "private": true,
  "description": "自选股行情悬浮窗小程序 —— A股/港股/美股/期货 全品类盯盘",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.local.watchticker",
    "productName": "WatchTicker",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "lib/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WatchTicker"
    }
  }
}
